tlb_time = 10
memory_time = 80

def calculate_eat(h):
    eat = h * (tlb_time + memory_time) + (1 - h) * (tlb_time + 2 * memory_time)
    return eat

h1 = 0.90
h2 = 0.75

print("TLB Lookup Time:", tlb_time, "ns")
print("Memory Access Time:", memory_time, "ns")

eat1 = calculate_eat(h1)
eat2 = calculate_eat(h2)

print("\nTLB Hit Ratio:", h1)
print("EAT:", eat1, "ns")

print("\nTLB Hit Ratio:", h2)
print("EAT:", eat2, "ns")

print("\nComparison:")
if eat1 < eat2:
    print("Hit ratio 0.90 gives better performance")
else:
    print("Hit ratio 0.75 gives better performance")
